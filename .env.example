# --- Showdown account (required for dashboard matchmaking) ---
# Use a dedicated Showdown account for the agent.
SHOWDOWN_USERNAME=
SHOWDOWN_PASSWORD=
# localhost:8000 -> local Showdown-compatible server (tests); any other host -> public Showdown.
SHOWDOWN_SERVER_URL=sim3.psim.us:8000

# --- Jev decision endpoint ---
JEV_ENDPOINT=https://opencode.ai/zen/v1/systemone
JEV_MODEL=jev-1.13-free
# A bare token is auto-prefixed with "Bearer ".
JEV_AUTH_TOKEN=Bearer public
JEV_TIMEOUT_SECONDS=10.0

# --- Agent / dashboard ---
BATTLE_FORMAT=gen9randombattle
DASHBOARD_PORT=8000
